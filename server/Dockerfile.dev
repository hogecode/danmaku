# Development image for NestJS with hot-reload support
FROM node:22-alpine

WORKDIR /app

# Install build and runtime dependencies including Playwright dependencies + system chromium
RUN apk add --no-cache dumb-init git python3 make g++ cairo-dev jpeg-dev pango-dev giflib-dev pixman-dev cairo jpeg pango giflib pixman chromium

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Copy package files first (layer caching)
COPY --chown=nodejs:nodejs package.json yarn.lock ./

# Install all dependencies (including dev dependencies)
RUN yarn install --frozen-lockfile --network-timeout 100000

# Skip Playwright browser download (use system chromium)
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Create necessary directories with proper permissions
RUN mkdir -p /app/dist /app/.eslintcache /tmp/nicovideo-downloads && \
    chown -R nodejs:nodejs /app/dist /app/.eslintcache && \
    chmod -R 777 /tmp/nicovideo-downloads

# Copy source code (excluding node_modules and dist via .dockerignore)
COPY --chown=nodejs:nodejs . .

# Fix permissions for volume mount
RUN chown -R nodejs:nodejs /app && \
    chmod -R 755 /app && \
    # Ensure node_modules is writable for hot-reload scenarios
    chmod -R 755 /app/node_modules

# Set NODE_ENV for development
ENV NODE_ENV=development

# Switch to non-root user
USER nodejs

# Expose ports for application and debugging
EXPOSE 3001 9229

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

# Start the application in watch mode for hot-reload
CMD ["yarn", "start:dev"]
