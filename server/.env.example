# ==================================================
# Danmaku - NestJS Backend Configuration
# ==================================================
# Backend-specific environment variables
# Copy to .env and update for your environment
# Note: Database and Redis settings should match root .env

# ==================================================
# Node Environment & Server
# ==================================================
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ==================================================
# Database (PostgreSQL)
# ==================================================
# Values should match root .env (POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB)
DATABASE_URL=postgresql://user:password@postgres:5432/danmaku

# ==================================================
# Redis Cache
# ==================================================
# Values should match root .env (REDIS_HOST, REDIS_PORT, REDIS_DB, REDIS_PASSWORD)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==================================================
# CORS & Security
# ==================================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://localhost,https://web.local,https://api.local,http://web.local,http://api.local,http://localhost:8080
CORS_CREDENTIALS=true
COOKIE_SECURE=false

# ==================================================
# JWT / Authentication
# ==================================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ALGORITHM=HS256

# ==================================================
# Session
# ==================================================
SESSION_SECRET=your-super-secret-session-key-min-32-chars!
SESSION_TTL=86400

# ==================================================
# OAuth Providers - Google
# ==================================================
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.local/api/auth/oauth/google/callback
GOOGLE_SCOPES=openid,email,profile,https://www.googleapis.com/auth/drive

# ==================================================
# OAuth Providers - OneDrive
# ==================================================
ONEDRIVE_OAUTH_ENABLED=true
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=https://api.local/api/auth/oauth/onedrive/callback
ONEDRIVE_SCOPES=openid,email,profile,Files.Read,offline_access

# ==================================================
# OAuth Providers - GitHub (Optional)
# ==================================================
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.local/api/auth/oauth/github/callback

# ==================================================
# Encryption
# ==================================================
ENCRYPTION_KEY=your-32-character-encryption-key-here!
ENCRYPTION_ALGORITHM=aes-256-gcm

# ==================================================
# File Storage
# ==================================================
STORAGE_PATH=./uploads
SCREENSHOT_MAX_SIZE=5242880
SCREENSHOT_QUALITY=90

# ==================================================
# Rate Limiting
# ==================================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==================================================
# Email (Optional)
# ==================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@danmaku.local

# ==================================================
# Monitoring & Logging
# ==================================================
ENABLE_AUDIT_LOG=true
ENABLE_PERFORMANCE_MONITORING=false

# ==================================================
# Feature Flags
# ==================================================
ENABLE_LOCAL_AUTH=true
ENABLE_OAUTH_GOOGLE=true
ENABLE_OAUTH_ONEDRIVE=true
ENABLE_OAUTH_GITHUB=false
ENABLE_SCREENSHOTS=true
ENABLE_PLAYLISTS=true
ENABLE_COMMENTS=true
