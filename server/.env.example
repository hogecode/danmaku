# ==================================================
# Danmaku Video Player - Backend Configuration
# ==================================================
# This file contains application-specific settings
# Copy to .env and update values for your environment

# ==================================================
# Server
# ==================================================
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# ==================================================
# Database
# ==================================================
DATABASE_URL=postgresql://user:password@localhost:5432/danmaku

# ==================================================
# Redis Cache
# ==================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==================================================
# JWT / Authentication
# ==================================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ALGORITHM=HS256

# ==================================================
# OAuth Providers - Google
# ==================================================
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/oauth/google/callback
GOOGLE_SCOPES=openid,email,profile,https://www.googleapis.com/auth/drive

# ==================================================
# OAuth Providers - OneDrive
# ==================================================
ONEDRIVE_OAUTH_ENABLED=true
ONEDRIVE_CLIENT_ID=your-onedrive-client-id
ONEDRIVE_CLIENT_SECRET=your-onedrive-client-secret
ONEDRIVE_REDIRECT_URI=http://localhost:3001/api/auth/oauth/onedrive/callback
ONEDRIVE_SCOPES=openid,email,profile,Files.Read,offline_access

# ==================================================
# OAuth Providers - GitHub (Optional)
# ==================================================
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3001/api/auth/oauth/github/callback

# ==================================================
# CORS & Security
# ==================================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
CORS_CREDENTIALS=true

# ==================================================
# Encryption
# ==================================================
# Must be exactly 32 characters (256 bits) for AES-256
ENCRYPTION_KEY=your-32-character-encryption-key-here!
ENCRYPTION_ALGORITHM=aes-256-gcm

# ==================================================
# Cloudflare CDN
# ==================================================
CLOUDFLARE_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_BUCKET_NAME=danmaku-videos

# ==================================================
# File Storage
# ==================================================
# Local file storage path
STORAGE_PATH=./uploads
SCREENSHOT_MAX_SIZE=5242880  # 5MB in bytes
SCREENSHOT_QUALITY=90

# ==================================================
# Rate Limiting
# ==================================================
RATE_LIMIT_WINDOW=900000  # 15 minutes in ms
RATE_LIMIT_MAX_REQUESTS=100

# ==================================================
# Session & Cookie
# ==================================================
SESSION_SECRET=your-super-secret-session-key-min-32-chars!
SESSION_TTL=86400  # 24 hours in seconds
COOKIE_SECURE=false  # Set to true in production with HTTPS
COOKIE_SAME_SITE=lax

# ==================================================
# Monitoring & Logging
# ==================================================
ENABLE_AUDIT_LOG=true
ENABLE_PERFORMANCE_MONITORING=false

# ==================================================
# Feature Flags
# ==================================================
ENABLE_LOCAL_AUTH=true
ENABLE_OAUTH_GOOGLE=true
ENABLE_OAUTH_ONEDRIVE=true
ENABLE_SCREENSHOTS=true
ENABLE_PLAYLISTS=true
