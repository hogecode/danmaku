# Development image for Next.js with hot-reload support
FROM node:20-alpine

WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Disable Next.js telemetry
ENV NEXT_TELEMETRY_DISABLED=1

# Enable file watching with polling for Docker file systems
# Critical for Turbopack to detect file changes in Docker
ENV CHOKIDAR_USEPOLLING=true
ENV CHOKIDAR_POLL_INTERVAL=1000
ENV WATCHPACK_POLLING=true
ENV TURBOPACK_LOG_VERBOSITY=debug

# Node options for Turbopack
ENV NODE_OPTIONS=--enable-source-maps

# Copy package files
COPY package.json package-lock.json ./

# Install all dependencies (including dev dependencies)
RUN npm install --frozen-lockfile

# Copy source code
COPY . .

# Fix permissions and ensure .next directory is writable
RUN mkdir -p /app/.next && \
    chmod -R 755 /app

# Expose development port
EXPOSE 3000

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]

# Start the application in development mode with hot-reload
# Run as root to avoid permission issues with mounted volumes
CMD ["npm", "run", "dev"]
